{
  "name": "chromora",
  "version": "1.4.0",
  "type": "module",
  "homepage": "https://github.com/alexeygasenko/Chromora",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexeygasenko/Chromora.git"
  },
  "scripts": {
    "build": "node build/build.js",
    "patch": "node build/patch.js && npm run build",
    "test": "node --test tests/*.mjs",
    "lint-check": "node build/check-syntax.mjs",
    "test:bundle": "node build/check-bundle.mjs && node build/smoke-bundle.mjs",
    "docs": "node build/generate-docs.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdoc": "^4.0.5",
    "minami": "^1.2.3",
    "playwright": "1.63.0",
    "taffydb": "npm:@jsdoc/salty@^0.2.12",
    "terser": "^5.43.1"
  }
}
